---
import { getCollection } from 'astro:content';
import Hero from '@components/widgets/Hero.astro';
import Layout from '@layouts/Layout.astro';
import PostCard from '@components/blog/PostCard.astro';
import PopularTopics from '@components/blog/PopularTopics.astro';
import { siteConfig } from '@config/site';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());
const latestPosts = sortedPosts.slice(0, 6);

const pillars = [
  { title: 'Ghiduri practice', href: '/categories/ghiduri-practice/', text: 'How-to-uri, acte, ANAF, masini, bani si pasi concreti.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { title: 'Bani si cariera', href: '/categories/bani-si-cariera/', text: 'Salarii, joburi remote, investitii si venituri secundare realiste.', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8v2m0 12v2m8-8h-2M6 12H4' },
  { title: 'Tech si AI', href: '/categories/tech-si-ai/', text: 'Aplicatii, gadgeturi, ChatGPT, privacy si securitate pe intelesul tuturor.', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z' },
  { title: 'Lifestyle practic', href: '/categories/lifestyle-practic/', text: 'Mutat in strainatate, sanatate, educatie, retete si bugete.', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5S19.832 5.477 21 6.253v13C19.832 18.477 18.246 18 16.5 18s-3.332.477-4.5 1.253' },
  { title: 'Digest tech si stiinta', href: '/categories/digest-tech-stiinta/', text: 'Selectii saptamanale, fara zgomot de breaking news.', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v8a2 2 0 01-2 2z' },
];
---

<Layout title={siteConfig.title} description={siteConfig.description} wideContent={true}>
  <main class="w-full py-8">
    <Hero />

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">Exploreaza continutul</h2>
        <p class="text-lg text-gray-700 dark:text-gray-300">Continut practic, gandit pentru cautarile si intrebarile romanilor.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {pillars.map((pillar) => (
          <a href={pillar.href} class="flex flex-col items-center p-6 bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg transition-shadow border border-gray-200 dark:border-gray-700 text-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-blue-600 dark:text-blue-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon} />
            </svg>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{pillar.title}</h3>
            <p class="text-gray-600 dark:text-gray-400">{pillar.text}</p>
          </a>
        ))}
      </div>
    </section>

    <PopularTopics tags={["romania", "ghiduri", "ai"]} postsPerTag={5} />

    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Articole recente</h2>
        <a href="/blog/" class="text-blue-600 dark:text-blue-400 hover:underline font-medium flex items-center">
          Vezi toate
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </main>
</Layout>
